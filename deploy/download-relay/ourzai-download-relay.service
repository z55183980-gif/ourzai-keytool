[Unit]
Description=ourzai installer download relay
After=network-online.target

[Service]
Type=simple
User=www-data
ExecStart=/usr/bin/python3 /opt/ourzai-download-relay/relay.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=256M
TasksMax=64

[Install]
WantedBy=multi-user.target
