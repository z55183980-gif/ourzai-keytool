{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "密钥管理工具",
  "version": "0.2.8",
  "identifier": "com.starnexus.dbkey",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "密钥管理工具",
        "width": 560,
        "height": 884,
        "center": true,
        "minWidth": 560,
        "minHeight": 560,
        "resizable": true,
        "theme": "Light"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "wix": {
        "language": "zh-CN"
      },
      "nsis": {
        "installerHooks": "./windows/hooks.nsh",
        "languages": [
          "SimpChinese",
          "TradChinese",
          "English"
        ],
        "displayLanguageSelector": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "createUpdaterArtifacts": true
  },
  "mainBinaryName": "starnexus-api",
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "com.ourzai.launcher"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ4NDQ0RjA4MTdFOTVGNTEKUldSUlgra1hDRTlFU0lBYWh2RW9yR3Q0MS9qVlVXRTlLWVl0YmZHTFlNMjRKK2g1NVVGcmJwRWIK",
      "endpoints": [
        "https://github.com/z55183980-gif/ourzai-keytool/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
